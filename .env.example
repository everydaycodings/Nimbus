DATABASE_URL=postgres://nimbus:nimbus@localhost:5432/nimbus
BETTER_AUTH_SECRET=  # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Required. Runs the health-check schedule (npm run worker).
REDIS_URL=redis://localhost:6380/0
# Optional. Caches the storage meter and health alarm on database 1.
CACHE_URL=redis://localhost:6380/1

# Leave empty to hide a provider's button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email. Set EMAIL_TRANSPORT to manage email from env (the admin panel turns read-only);
# leave it unset to configure email in /admin/email, where secrets are stored encrypted.
EMAIL_TRANSPORT=  # none | smtp | resend
EMAIL_FROM=       # Nimbus <nimbus@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false # true for TLS from the start (port 465)
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Backups (Admin → Backups). Run the worker with: npm run worker:backup (needs Docker).
# Encrypts every database dump and, if on, every file copy. Keep a copy offline:
# without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=  # openssl rand -base64 32
# Optional. Set BACKUP_S3_BUCKET to manage backup storage from env (the admin panel
# turns read-only); leave it unset to configure storage in Admin → Backups → Settings.
BACKUP_S3_PROVIDER=     # aws | r2 | b2 | wasabi | minio | other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_FOLDER=nimbus
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
