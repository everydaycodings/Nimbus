# Copy to .env at the repo root (next to docker-compose.yml), or let ./setup.sh write it.
# Keep comments on their own lines: docker compose reads "KEY=  # note" as the value "# note".

# Optional services to run here, comma-separated: postgres, minio, backup, push, ml.
# Leave postgres or minio out to use your own (set DATABASE_URL or S3_* below).
COMPOSE_PROFILES=postgres,minio

# The app's public name. It needs a DNS A record pointing at this server.
DOMAIN=nimbus.example.com
# Only with the minio profile: the storage's public name, also pointing here.
# Browsers download files from it directly. Leave empty when using your own S3.
S3_DOMAIN=s3.nimbus.example.com
# Let's Encrypt account email, used by setup-nginx.sh
CERTBOT_EMAIL=you@example.com

# Generate each with: openssl rand -hex 24
TUS_HOOK_SECRET=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts every backup. Generate with: openssl rand -base64 32
# Keep a copy offline: without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=

# Secrets (the /secrets section). Wraps each project's data key, which seals every value.
# Generate with: openssl rand -base64 32. Keep a copy offline: if it's lost or changed,
# every stored secret is unreadable. Backups hold the sealed values, not this key.
SECRETS_ROOT_KEY=
# Only while rotating the root key (see README, Credentials): the key you are moving away from.
SECRETS_ROOT_KEY_PREVIOUS=
# Shared secret between the app and the ml profile (nimbus-ml). Generate with: openssl rand -hex 24
ML_TOKEN=
# Optional: memory limit for the ml container. 3g fits the default models; use 4g or more
# when the admin picks the multilingual photo search model (it needs about 2.5 GB).
# NIMBUS_ML_MEMORY=3g

# Database. With the postgres profile, set POSTGRES_PASSWORD (openssl rand -hex 24)
# and put the same password in both URLs below.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://nimbus:<POSTGRES_PASSWORD>@postgres:5432/nimbus
# The same database as seen from this host (the backup worker runs on the host network).
HOST_DATABASE_URL=postgres://nimbus:<POSTGRES_PASSWORD>@127.0.0.1:54340/nimbus
# Your own Postgres instead: put its URL in both. A Postgres on this host is
# host.docker.internal in DATABASE_URL and 127.0.0.1 in HOST_DATABASE_URL.

# File storage. With the minio profile: S3_ENDPOINT=https://<S3_DOMAIN>, keep the
# rest and set S3_SECRET_KEY (openssl rand -hex 24).
# Your own S3 instead (AWS, R2, B2, Wasabi, …): fill in its values; leave
# S3_ENDPOINT empty for AWS. The bucket needs the CORS rule from the README.
S3_ENDPOINT=https://s3.nimbus.example.com
S3_REGION=us-east-1
S3_BUCKET=nimbus
S3_ACCESS_KEY=nimbus
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Optional sign-in providers. Callback URL: https://<DOMAIN>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Set EMAIL_TRANSPORT (none, smtp or resend) to manage email here, and the
# admin panel turns read-only; leave it empty to configure email in Admin → System → Email.
# EMAIL_FROM looks like: Nimbus <nimbus@example.com>
# SMTP_SECURE=true means TLS from the start (port 465).
EMAIL_TRANSPORT=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Optional. Set BACKUP_S3_BUCKET to manage backup storage here; leave it empty to
# configure it in Admin → System → Backups. Use storage off this server.
# BACKUP_S3_PROVIDER is one of: aws, r2, b2, wasabi, minio, other
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_FOLDER=nimbus
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Optional office viewer: where a Collabora server reaches Nimbus. Set the Collabora
# URL itself in Admin → System → Office.
WOPI_BASE_URL=

# Optional. Requests a minute on /api/v1: per signed-in member, and per IP on /api/v1/instance.
API_RATE_LIMIT_USER=1200
API_RATE_LIMIT_INSTANCE_IP=120
