# Container registry (profile "registry"). The Host header names the registry in redirects and tokens, so
# pass it on unchanged. Layers stream: nothing is buffered or size-limited.
server {
    listen 80;
    server_name ${REGISTRY_DOMAIN};
    # The visitor's IP when a trusted proxy (Cloudflare, TRUSTED_PROXIES) is in front; written by setup-nginx.sh.
    include /etc/nginx/snippets/nimbus-realip.conf;

    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:3408;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
