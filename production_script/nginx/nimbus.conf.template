# Rendered by setup-nginx.sh into /etc/nginx/sites-available/nimbus, with
# nimbus-s3.conf.template after it when MinIO runs here. certbot then adds HTTPS
# and the http → https redirect.

server {
    listen 80;
    server_name ${DOMAIN};

    # Files go through /files/ in resumable chunks; this covers forms and actions.
    client_max_body_size 64m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;

    # Resumable uploads (tusd): stream chunks straight through.
    location /files/ {
        proxy_pass http://127.0.0.1:3401;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # WebDAV (scripts/webdav.ts): mounted drives stream whole files.
    location /dav {
        proxy_pass http://127.0.0.1:3404;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Windows' "Map network drive" asks the site root whether it speaks WebDAV.
    location = / {
        if ($request_method = OPTIONS) {
            add_header DAV "1, 2";
            add_header MS-Author-Via DAV;
            add_header Allow "OPTIONS, PROPFIND";
            return 200;
        }
        proxy_pass http://127.0.0.1:3400;
    }

    location / {
        proxy_pass http://127.0.0.1:3400;
        # Zips are streamed while they're built.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
