# Copy to .env to override the dev defaults baked into compose.yml
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus
POSTGRES_DB=nimbus
S3_ACCESS_KEY=nimbus
S3_SECRET_KEY=nimbus-secret
S3_BUCKET=nimbus
APP_ORIGIN=http://localhost:3000
TUS_HOOK_URL=http://host.docker.internal:3000/api/tus-hooks

# Host ports (defaults avoid the common 9000/6379 clashes)
POSTGRES_PORT=5432
S3_PORT=9100
S3_CONSOLE_PORT=9101
TUS_PORT=1080
REDIS_PORT=6380
